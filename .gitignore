# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Packaged DMG / staging (multi-GB; rebuild with scripts/package_macos_dmg.sh)
/dist/
*.dmg

# macOS CocoaPods / Flutter generated
/macos/Pods/
/macos/Flutter/ephemeral/
**/xcuserdata/

# OCR worker
ocr_worker/.venv/
ocr_worker/__pycache__/
**/__pycache__/
*.pyc

# Local secrets / model weights (never commit real weights if large)
.env
*.pem
assets/models/paddleocr-vl-1.6/**
!assets/models/paddleocr-vl-1.6/MANIFEST.json
!assets/models/paddleocr-vl-1.6/.gitkeep
